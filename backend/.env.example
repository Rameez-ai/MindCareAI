# MindCareAI Environment Variables

# Application Settings
APP_NAME=MindCareAI
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Settings
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=app/config/firebase-credentials.json
# Alternative: Firebase Project ID if using default credentials (e.g. deployed to GCP)
FIREBASE_PROJECT_ID=mindcareai-firebase-project

# Gemini API Key (for Gemini Flash LLM)
GOOGLE_API_KEY=your-gemini-api-key-here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
